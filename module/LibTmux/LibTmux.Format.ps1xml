<?xml version='1.0' encoding='utf-8'?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>LibTmux.Server</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.Server</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Socket</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ServerPID</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Connected</Label>
            <Width>10</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>if ($_.ConnectionOptions.SocketPath) { $_.ConnectionOptions.SocketPath } else { $_.ConnectionOptions.SocketName }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.Generation) { $_.Generation.ProcessId }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsMaterialized</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>LibTmux.Session</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.Session</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Id</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ServerPID</Label>
            <Width>10</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Id</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>try { $_.get_RawFormatFields()['session_name'] } catch [LibTmux.IncompleteSnapshotException] { $null }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Generation.ProcessId</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>LibTmux.Window</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.Window</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Id</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Session</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Index</Label>
            <Width>10</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Id</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>try { $_.get_RawFormatFields()['window_name'] } catch [LibTmux.IncompleteSnapshotException] { $null }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>try { $_.get_RawFormatFields()['session_id'] } catch [LibTmux.IncompleteSnapshotException] { $null }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>try { $_.get_RawFormatFields()['window_index'] } catch [LibTmux.IncompleteSnapshotException] { $null }</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>LibTmux.Pane</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.Pane</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Id</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Window</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Index</Label>
            <Width>10</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Id</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Title</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>try { $_.get_RawFormatFields()['window_id'] } catch [LibTmux.IncompleteSnapshotException] { $null }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>try { $_.get_RawFormatFields()['pane_index'] } catch [LibTmux.IncompleteSnapshotException] { $null }</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>LibTmux.PaneRunResult</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.PaneRunResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Pane</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>TimedOut</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Elapsed</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Started</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Missed</Label><Width>8</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>PaneId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExitStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TimedOut</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Elapsed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Started</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.LinesMissed -or $_.AnchorLost</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>LibTmux.PaneWaitResult</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.PaneWaitResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Pane</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Outcome</Label></TableColumnHeader>
          <TableColumnHeader><Label>Elapsed</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Dropped</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Missed</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Polling</Label><Width>10</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>PaneId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Outcome</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Elapsed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EventsDropped</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.LinesMissed -or $_.AnchorLost</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>PollingFallback</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>LibTmux.Client</Name>
      <ViewSelectedBy>
        <TypeName>LibTmux.Client</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Session</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Control</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ServerPID</Label>
            <Width>10</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Name</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>AttachedSessionId</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsControlClient</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Generation.ProcessId</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
