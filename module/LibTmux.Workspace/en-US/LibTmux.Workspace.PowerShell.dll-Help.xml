<?xml version="1.0" encoding="utf-8"?>
<helpItems xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" schema="maml" xmlns="http://msh">
  <command:command>
    <command:details>
      <command:name>Import-TmuxWorkspace</command:name>
      <maml:description>
        <maml:para>Parse a workspace declaration without executing it.</maml:para>
      </maml:description>
      <command:verb>Import</command:verb>
      <command:noun>TmuxWorkspace</command:noun>
    </command:details>
    <maml:description>
      <maml:para>Read a literal file path or parse supplied YAML text into a native WorkspaceFile. Parsing does not start tmux, send shell commands or execute host scripts. This command accepts the current shared engine subset; complete plan/apply is still under development.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Import-TmuxWorkspace</maml:name>
        <command:parameter required="true" variableLength="false" globbing="false" pipelineInput="false" position="0" aliases="none">
          <maml:name>LiteralPath</maml:name>
          <maml:description />
          <command:parameterValue required="true" variableLength="false">string</command:parameterValue>
          <dev:type>
            <maml:name>System.String</maml:name>
          </dev:type>
        </command:parameter>
      </command:syntaxItem>
      <command:syntaxItem>
        <maml:name>Import-TmuxWorkspace</maml:name>
        <command:parameter required="true" variableLength="false" globbing="false" pipelineInput="false" position="named" aliases="none">
          <maml:name>Yaml</maml:name>
          <maml:description />
          <command:parameterValue required="true" variableLength="false">string</command:parameterValue>
          <dev:type>
            <maml:name>System.String</maml:name>
          </dev:type>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" variableLength="false" globbing="false" pipelineInput="false" position="0" aliases="none">
        <maml:name>LiteralPath</maml:name>
        <maml:description>
          <maml:para>The literal file path to read.</maml:para>
        </maml:description>
        <command:parameterValue required="true" variableLength="true">System.String</command:parameterValue>
        <dev:type>
          <maml:name>System.String</maml:name>
        </dev:type>
      </command:parameter>
      <command:parameter required="true" variableLength="false" globbing="false" pipelineInput="false" position="Named" aliases="none">
        <maml:name>Yaml</maml:name>
        <maml:description>
          <maml:para>Yaml declaration text.</maml:para>
        </maml:description>
        <command:parameterValue required="true" variableLength="true">System.String</command:parameterValue>
        <dev:type>
          <maml:name>System.String</maml:name>
        </dev:type>
      </command:parameter>
    </command:parameters>
    <command:inputTypes />
    <command:returnValues>
      <command:returnValue>
        <dev:type>
          <maml:name>LibTmux.Workspace.WorkspaceFile</maml:name>
        </dev:type>
        <maml:description>
          <maml:para>Native pipeline type for this command.</maml:para>
        </maml:description>
      </command:returnValue>
    </command:returnValues>
    <maml:alertSet>
      <maml:alert>
        <maml:para>LiteralPath reads the specified file without wildcard expansion. Yaml accepts declaration text. Neither form is a workspace loader.</maml:para>
      </maml:alert>
    </maml:alertSet>
    <command:examples>
      <command:example>
        <maml:title>--------- Example 1 ---------</maml:title>
        <maml:introduction>
          <maml:para>Inspect a declaration without executing it.</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>```powershell
LibTmux.Workspace\Import-TmuxWorkspace -Yaml 'session_name: development'
```</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
      </command:example>
    </command:examples>
